# 프로젝트 루트(.env)에 둔다. python-decouple 이 이 파일을 직접 읽는다.
# systemd 유닛의 EnvironmentFile 로는 넣지 않는다 — docs/deployment.md 참고.

# === Django ===
# SECRET_KEY 는 손으로 만들지 않는다. 추측 가능한 값은 키가 아니다.
#   venv/bin/python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=your-domain.com,your-server-ip,localhost,127.0.0.1

# === nginx 뒤에서 (docs/nginx-tls.md 5단계) ===
# 인증서가 실제로 뜬 뒤에 켠다. 먼저 켜면 로그인이 막힌다.
BEHIND_TLS_PROXY=False
CSRF_TRUSTED_ORIGINS=
SECURE_COOKIES=False

# === 로그인 시도 제한 ===
# 없으면 기본값(10회 / 1시간)이 쓰인다.
AXES_FAILURE_LIMIT=10
AXES_COOLOFF_HOURS=1

# === 키움 API — 주계좌 ===
APPKEY=
SECRETKEY=

# === 키움 API — 계좌를 더 쓸 때 ===
# 접미사는 Account.key 와 같은 이름을 쓴다 (대문자).
#   APPKEY_SUB1 / SECRETKEY_SUB1  ->  토큰은 token_sub1.json 에 저장된다
# APPKEY_SUB1=
# SECRETKEY_SUB1=

# === 텔레그램 — 배치 알림 (봇) ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === 텔레그램 — 채널 읽기 (사용자 계정, telethon) ===
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# DART 는 키가 필요 없다. 뷰어 페이지를 User-Agent 만 붙여 읽는다.
