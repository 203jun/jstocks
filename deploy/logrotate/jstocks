# jstocks 로그 정리
#
#   cp deploy/logrotate/jstocks /etc/logrotate.d/jstocks
#   chmod 644 /etc/logrotate.d/jstocks
#   logrotate -d /etc/logrotate.d/jstocks     # 먼저 시늉만 (-d 는 아무것도 안 바꾼다)
#   logrotate -f /etc/logrotate.d/jstocks     # 한 번 강제로 돌려 보기
#
# 왜 있나
#   stocks.log 가 177M 까지 자랐다. 디스크가 모자란 것은 아니지만(26G 중
#   12G 남음) 그만한 파일은 열어볼 수가 없다. 문제가 생겼을 때 들여다보는
#   것이 로그의 존재 이유인데 tail 말고는 손댈 방법이 없어진다.

/home/stock/jstocks/logs/*.log {
    daily
    rotate 14
    compress
    # 어제 것(.1)은 압축하지 않고 둔다. 방금 일을 볼 때가 가장 많고,
    # 그때 gunzip 을 거치지 않아도 된다.
    delaycompress
    missingok
    notifempty

    # 파일을 옮기지 않고 '복사한 뒤 비운다'.
    #
    # 보통은 이름을 바꾸고 새 파일을 만드는데(create), 그러면 그 파일을 이미
    # 열고 있던 프로세스는 이름 바뀐 쪽에 계속 쓴다. 새 파일은 영영 비어
    # 있게 된다.
    #
    # 배치가 도는 중(15:40 · 19:40 · 금 23:00)에 로테이션이 겹치면 그 일이
    # 생긴다. *_update.log 는 셸이 >> 로 열어 배치 내내 붙잡고 있고,
    # stocks.log 도 명령이 도는 동안은 열려 있다. copytruncate 는 그 문제가
    # 없다 — 복사와 비우기 사이에 쓰인 몇 줄을 잃을 수 있지만, 그쪽이 로그가
    # 통째로 끊기는 것보다 낫다.
    copytruncate

    # 하루를 못 기다릴 만큼 커지면 그때 자른다. 배치가 한 번 폭주하면
    # 하루 만에도 수백 MB 가 쌓인다.
    maxsize 50M

    # 로그는 stock 소유다. 이 줄이 없으면 logrotate 가 '남의 디렉터리'
    # 라며 건너뛴다.
    su stock stock
}
