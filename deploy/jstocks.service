# jstocks — systemd 유닛
#
#   /etc/systemd/system/jstocks.service 로 복사한 뒤
#   systemctl daemon-reload && systemctl restart jstocks
#
# 지금 돌고 있는 것과 반드시 비교하고 쓴다:
#   systemctl cat jstocks
#
# 레포에 있던 옛 파일은 WorkingDirectory 가 /home/stock 이었는데 그 자리에서는
# jstocks.wsgi 를 임포트할 수 없다(프로젝트는 /home/stock/jstocks 에 있다).
# 실제로 돌고 있는 유닛과 달랐다는 뜻이므로, 덮어쓰기 전에 꼭 확인한다.

[Unit]
Description=JStocks Django Application
After=network.target

[Service]
User=root
Group=root
WorkingDirectory=/home/stock/jstocks
Environment="PATH=/home/stock/jstocks/venv/bin"
EnvironmentFile=/home/stock/jstocks/.env

# 127.0.0.1 로만 듣는다.
#
# 예전에는 0.0.0.0:8000 이라 바깥에서 바로 들어올 수 있었다. nginx 를 세워도
# 8000 이 열려 있으면 https 를 건너뛰고 평문으로 접속할 수 있다 — 그러면
# 인증서를 붙인 뜻이 없어진다. 방화벽에서 8000 을 막는 것과 같이 쓴다.
#
# --timeout 120 은 nginx 의 proxy_read_timeout 과 짝이다. 기본 30초로는
# DART 를 긁는 요청이 먼저 끊긴다.
ExecStart=/home/stock/jstocks/venv/bin/gunicorn \
    --bind 127.0.0.1:8000 \
    --workers 1 \
    --timeout 120 \
    jstocks.wsgi:application

Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
